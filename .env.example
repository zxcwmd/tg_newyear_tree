# Скопируй в .env и заполни
BOT_TOKEN=123456:ABC-DEF...
# Публичный URL Mini App (https), например https://abcd.ngrok-free.app
# Для продакшна — твой домен с HTTPS
WEBAPP_URL=https://your-domain.example.com
# Порт для Mini App сервера
WEBAPP_PORT=8000
# Путь к SQLite базе
DATABASE_PATH=./data.db
# Часовой пояс для дедлайна 1 января (по умолчанию Europe/Moscow)
TIMEZONE=Europe/Moscow

# ── Telegram-подарки на ёлке (Bot API getUserGifts) ──
# 1 — игроки могут прикреплять свои подарки из Telegram, 0 — выключить вкладку
TELEGRAM_GIFTS_ENABLED=1
# Сколько последних подарков запрашивать (1–100)
TELEGRAM_GIFTS_LIMIT=24
# Адрес Bot API (для прокси/локального Bot API сервера)
TELEGRAM_API_BASE=https://api.telegram.org

# ── Внутриигровые NFT (отдельная механика, по умолчанию выключена) ──
NFT_MINT_ENABLED=0
NFT_COLLECTION_ADDRESS=
TON_API_KEY=
